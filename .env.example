# Copy into the stack's .env in Dockge and adjust. Every line is optional.

# Where the guests' photos are (mounted read-only) and where the app keeps its database + thumbnails.
PHOTOS_PATH=/mnt/tank/Photos/wedding-guests
DATA_PATH=/mnt/tank/apps/wedding-triage
PORT=8484

# Names on the "who's sorting?" screen.
USERS=Husband,Wife

# Timezone of the wedding. Photos carry their own local time and ignore this; videos only store
# UTC, so this is what puts them at the right hour next to the photos.
TZ=Europe/Paris

# Folders to leave out for now, comma separated (RAW files are always ignored).
# EXCLUDE=Uncle Bob/*

# Raise to flag more photos as blurry, lower to flag fewer.
# BLUR_BELOW=45

# Immich export (add whenever you are ready; restart the stack afterwards).
# IMMICH_URL=http://192.168.1.10:2283
# IMMICH_API_KEY=
# IMMICH_ALBUM=Wedding - guest picks
